struct Circle
{
    r: float
}

struct Square
{
    side: float
}

type Vec2 = (float, float)



interface Shape
{
    area(self) -> float
    name(self) -> string
}

interface Scalable
{
    scale(ref self, k: float)
}

code Circle as Shape
{
    fn area(self) -> float
    {
        return math::pi() * self.r * self.r
    }

    fn name(self) -> string
    {
        return "circle"
    }
}

code Square as Shape
{
    fn area(self) -> float
    {
        return self.side * self.side
    }

    fn name(self) -> string
    {
        return "square"
    }
}

code Circle as Scalable
{
    fn scale(ref self, k: float)
    {
        self.r = self.r * k
    }
}

code Square as Scalable
{
    fn scale(ref self, k: float)
    {
        self.side = self.side * k
    }
}

code int
{
    fn squared(self) -> int
    {
        return self * self
    }

    fn is_prime(self) -> bool
    {
        if self < 2
        {
            return false
        }

        var i = 2
        while i * i <= self
        {
            if self % i == 0
            {
                return false
            }

            i = i + 1
        }

        return true
    }
}

code float
{
    fn rounded(self) -> float
    {
        return (self * 100.0).round() / 100.0
    }
}

code string
{
    fn shout(self) -> string
    {
        return self.upper() + "!"
    }
}

code int[]
{
    fn average(self) -> float
    {
        if self.is_empty()
        {
            return 0.0
        }

        return self.sum().to_float() / self.length().to_float()
    }
}

code Vec2
{
    fn norm(self) -> float
    {
        return (self[0] * self[0] + self[1] * self[1]).sqrt()
    }

    fn plus(self, other: Vec2) -> Vec2
    {
        return (self[0] + other[0], self[1] + other[1])
    }
}

fn make_counter(start: int) -> fn() -> int
{
    var n = start

    return || {
        n = n + 1
        return n
    }
}

fn describe(v: (int | string | bool)) -> string
{
    check v as int => n { return 'the int {n}' }
    check v as string => s { return 'the string "{s}"' }

    return "something else"
}


fn compose(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int
{
    return |x| g(f(x))
}

fn section(title: string)
{
    println("")
    println('== {title} ==')
}

fn demo_code_blocks()
{
    section("code blocks")

    println(7.squared(), 12.squared())
    println("hey".shout())
    println([1, 2, 3, 4].average())
    println(3.14159.rounded())

    var v: Vec2 = (3.0, 4.0)
    println(v.norm(), v.plus((1.0, 1.0)))

    println((1..=30).filter(|n| n.is_prime()))

    var total = (1..=30)
        .filter(|n| n.is_prime())
        .map(|n| n.squared())
        .sum()

    println('sum of the squares of the primes up to 30: {total}')
}

fn demo_interfaces()
{
    section("interfaces")

    var shapes: Shape[] = [#Circle{r = 1.0}, #Square{side = 2.0}, #Circle{r = 0.5}]

    for shape in shapes.sorted_by(|sh| sh.area())
    {
        println('{shape.name()} with area {shape.area().rounded()}')
    }

    println('total area: {shapes.map(|sh| sh.area()).sum().rounded()}')

    for shape in shapes
    {
        check shape as Circle => c
        {
            println('a circle with radius {c.r}')
        }
    }

    var growing: Scalable = #Square{side = 3.0}
    growing.scale(0.5)
    growing.scale(3.0)

    check growing as Square => q
    {
        println('the square is now {q.side} wide')
    }
}

fn demo_lambdas()
{
    section("lambdas and the std")

    var nums = [5, 3, 8, 1, 9, 2]

    println(nums.map(|x| x * 2))                        // [10, 6, 16, 2, 18, 4]
    println(nums.filter(|x| x > 4).sorted())            // [5, 8, 9]
    println(nums.fold(0, |acc, x| acc + x))             // 28
    println(nums.sorted_by(|x| -x))                     // [9, 8, 5, 3, 2, 1]
    println(nums.find(|x| x % 2 == 0).or(-1))           // 8

    var evens = 0
    (1..=10).for_each(ref |i| { if i % 2 == 0 { evens = evens + 1 } })
    println('{evens} even numbers between 1 and 10')    // 5

    var counts = @[string, int].new()

    for word in "the quick the lazy the end".split(" ")
    {
        counts[word] = counts.get_or(word, 0) + 1
    }

    println(counts)

    for entry in counts.entries().sorted_by(|e| -e[1]).take(2)
    {
        var (word, n) = entry
        println('{word}: {n}')
    }
}

fn demo_closures()
{
    section("closures keep their own state")

    var a = make_counter(0)
    var b = make_counter(100)
    println(a(), a(), b(), a())

    var inc_then_double = compose(|x| x + 1, |x| x * 2)
    var triple_then_dec = compose(|x| x * 3, |x| x - 1)
    println(inc_then_double(5), triple_then_dec(5))
}

fn demo_values()
{
    section("values")

    var (x, y) = (1, 2)
    (x, y) = (y, x)
    println(x, y)

    var (f0, f1) = (0, 1)
    for i in 0..10
    {
        (f0, f1) = (f1, f0 + f1)
    }
    println('fib(10) = {f0}')

    println(describe(42))
    println(describe("hi"))
    println(describe(true))

    var mixed: (int | string)[] = [1, "two", 3, "four"]
    var int_total = 0
    var words = 0

    for item in mixed
    {
        check item as int => n { int_total = int_total + n } else { words = words + 1 }
    }

    println(mixed, int_total, words)

    var names = ["bob", "bob2.0", "skibidi"]
    println(names.at(1).map(|n| n.upper()).or("nobody"))
    println(names.at(9).map(|n| n.upper()).or("nobody"))

    check names.at(2) => who { println('the third is {who}') } else { println("there is no third") }

    var a = @[int].fromv(1, 2, 3, 4)
    var b = @[int].fromv(3, 4, 5)
    println(a.intersect(b), a.union(b), a.difference(b))    // {3, 4} {1, 2, 3, 4, 5} {1, 2}
}

fn main()
{
    demo_code_blocks()
    demo_interfaces()
    demo_lambdas()
    demo_closures()
    demo_values()
}