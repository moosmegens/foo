interface Drawable
{
    draw(x: int, y: int)
    resize(width: int, height: int) -> bool
    clear()
}

interface Mutable
{
    update(ref value: int)
    get() -> int
}

fn repeat(c: int, f: fn())
{
    for _ in 0..c f()
}

fn main() -> any
{
    var a = 0

    repeat(10, ref || { a = a + 1 } )

    return a
}