// are there three p's in a row starting at (x,y) going in direction (dx,dy)?
fn line3(board: _, x: int, y: int, dx: int, dy: int, p: int): bool
{
    for i in range(0, 3)
    {
        var cx = x + dx * i;
        var cy = y + dy * i;
        if (cx < 0 || cx >= 4 || cy < 0 || cy >= 3)
        {
            return false;
        }
        if board[cy * 4 + cx] != p
        {
            return false;
        }
    }
    return true;
}

fn makes_three(board: _, p: int): bool
{
    for y in range(0, 3)
    {
        for x in range(0, 4)
        {
            if line3(board, x, y, 1, 0, p)
            {
                return true;
            }
            if line3(board, x, y, 0, 1, p)
            {
                return true;
            }
            if line3(board, x, y, 1, 1, p)
            {
                return true;
            }
            if line3(board, x, y, 1, -1, p)
            {
                return true;
            }
        }
    }
    return false;
}

fn is_full(board: _): bool
{
    for i in range(0, 12)
    {
        if board[i] == 0
        {
            return false;
        }
    }
    return true;
}

// score from the point of view of p, the player about to move.
// misere rules: whoever makes three in a row LOSES.
fn negamax(board: _, p: int, depth: int, alpha: int, beta: int): int
{
    var o = 3 - p;

    if makes_three(board, o)
    {
        return 100 - depth;   // the opponent just made three, so p wins (sooner is better)
    }
    if is_full(board)
    {
        return 0;
    }

    var a = alpha;
    var best = -1000000;
    var cut = false;

    for i in range(0, 12)
    {
        if cut == false
        {
            if board[i] == 0
            {
                var next = board;      // value copy
                next[i] = p;
                var s = 0 - negamax(next, o, depth + 1, 0 - beta, 0 - a);
                if s > best
                {
                    best = s;
                }
                if best > a
                {
                    a = best;
                }
                if a >= beta
                {
                    cut = true;
                }
            }
        }
    }
    return best;
}

fn best_move(board: _, p: int): int
{
    var o = 3 - p;
    var alpha = -1000000;
    var best_score = -1000000;
    var best_i = -1;

    for i in range(0, 12)
    {
        if board[i] == 0
        {
            var next = board;
            next[i] = p;
            var s = 0 - negamax(next, o, 1, -1000000, 0 - alpha);
            if s > best_score
            {
                best_score = s;
                best_i = i;
            }
            if s > alpha
            {
                alpha = s;
            }
        }
    }

    if best_score > 0
    {
        io::println("AI: I have a forced win!");
    }
    return best_i;
}

