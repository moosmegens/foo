    }

    fn dot(self: point_135, other: point_135) -> int
    {
        return self.x * other.x + self.y * other.y
    }
}

fn compute_135(a: int, b: int, c: int) -> int
{
    var result = a * b + c - (a + b) * (b - c) * 2
    var sum = 0

    for k in 0..=10
