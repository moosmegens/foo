fn print_board(board: _)
{
    for y in range(0, 3)
    {
        io::print("|");
        for x in range(0, 3)
        {
            var value = board[y * 3 + x];
            if value == 0
            {
                io::print(" ");
            }
            if value == 1
            {
                io::print("X");
            }
            if value == 2
            {
                io::print("O");
            }
            io::print("|");
        }
        io::println("");
    }
}

fn fib(n: int): int
{
    var a = 0;
    var b = 1;

    for i in 0 .. n
    {
        var next = a + b;
        a = b;
        b = next;
    }

    return a;
}

fn func(): string
{

}

fn main(): int
{
    var a = 5;
    io::println(-5..=5);
    io::println(a * 2 ..= a * 3);
    io::println(fib(92));
    io::println(a == 5);
    io::println((0..6) == (0..=5));
    io::println((0..=5)[5] == 5);

    io::println(func());

    var board = [0, 0, 0, 0, 0, 0, 0, 0, 0];

    var turn_count = 0;

    while turn_count < 9
    {
        var good_move = false;

        print_board(board);
        var user_input = io::input("> ");

        if user_input == "quit"
        {
            return 0;
        }

        var move = to_int(user_input);
        if (move <= 0 || move > 9)
        {
            io::println("move", move, "is out of bounds");
        } else {
            good_move = true;
        }

        if good_move
        {
            if (board[move-1] == 0)
            {
                board[move-1] = (turn_count % 2) + 1;
                turn_count = turn_count + 1;
                io::println();
            } else {
                io::println("there is already a piece here");
            }
        }
    }

    return 0;
}