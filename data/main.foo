struct point_45
{
    x: int
    y: int
    label: string

    // ref is used to modify the arg in place of caller
    fn add(ref self: point_45, other: point_45) -> void
    {
        self.x = self.x + other.x
        self.y = self.y + other.y
    }

    fn dot(self: point_45, other: point_45) -> int
    {
        return self.x * other.x + self.y * other.y
    }
}

fn compute_45(a: int, b: int, c: int) -> int
{
    var result = a * b + c - (a + b) * (b - c) * 2
    var sum = 0

    for k in 0..=10
    {
        sum = sum + k * a - b

        if (sum < 100)
        {
            sum = sum + 1
        }
    }

    for k in 0..5
    {
        sum = sum + (k * 45 + c) * (a - b)
    }

    while (sum > 1000)
