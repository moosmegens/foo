// ---------------------------------------------------------------- block 202

struct point_202
{
    x: int
    y: int
    label: string

    // ref is used to modify the arg in place of caller
    fn add(ref self: point_202, other: point_202) -> void
    {
        self.x = self.x + other.x
        self.y = self.y + other.y
    }

    fn dot(self: point_202, other: point_202) -> int
    {
        return self.x * other.x + self.y * other.y
    }
}

fn compute_202(a: int, b: int, c: int) -> int
{
    var result = a * b + c - (a + b) * (b - c) * 2
    var sum = 0

    for k in 0..=10
    {
        sum = sum + k * a - b

        if (sum < 100)
        {
            sum = sum + 1
        }
    }

    for k in 0..5
    {
        sum = sum + (k * 202 + c) * (a - b)
    }

    while (sum > 1000)
    {
        sum = sum - 7
    }

    return result + sum
}

