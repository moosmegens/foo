        self.y = self.y + other.y
    }

    fn dot(self: point_2509, other: point_2509) -> int
    {
        return self.x * other.x + self.y * other.y
    }
}

fn compute_2509(a: int, b: int, c: int) -> int
{
    var result = a * b + c - (a + b) * (b - c) * 2
    var sum = 0

    for k in 0..=10
    {
        sum = sum + k * a - b

        if (sum < 100)
        {
            sum = sum + 1
        }
