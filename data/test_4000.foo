struct point_1542
{
    x: int
    y: int
    label: string

    // ref is used to modify the arg in place of caller
    fn add(ref self: point_1542, other: point_1542) -> void
    {
        self.x = self.x + other.x
        self.y = self.y + other.y
    }

    fn dot(self: point_1542, other: point_1542) -> int
    {
        return self.x * other.x + self.y * other.y
    }
}

fn compute_1542(a: int, b: int, c: int) -> int
{
    var result = a * b + c - (a + b) * (b - c) * 2
    var sum = 0

    for k in 0..=10
    {
        sum = sum + k * a - b

        if (sum < 100)
        {
            sum = sum + 1
        }
    }

    for k in 0..5
    {
        sum = sum + (k * 1542 + c) * (a - b)
    }

    while (sum > 1000)
    {
        sum = sum - 7
    }

    return result + sum
}

