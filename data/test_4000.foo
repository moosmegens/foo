// ---------------------------------------------------------------- block 1982

struct point_1982
{
    x: int
    y: int
    label: string

    // ref is used to modify the arg in place of caller
    fn add(ref self: point_1982, other: point_1982) -> void
    {
        self.x = self.x + other.x
        self.y = self.y + other.y
    }

    fn dot(self: point_1982, other: point_1982) -> int
    {
        return self.x * other.x + self.y * other.y
    }
}

fn compute_1982(a: int, b: int, c: int) -> int
{
    var result = a * b + c - (a + b) * (b - c) * 2
    var sum = 0

    for k in 0..=10
    {
        sum = sum + k * a - b

        if (sum < 100)
        {
            sum = sum + 1
        }
    }

    for k in 0..5
    {
        sum = sum + (k * 1982 + c) * (a - b)
    }

    while (sum > 1000)
    {
        sum = sum - 7
    }

    return result + sum
}

fn arrays_1982() -> int[][]
{
    var grid: int[][] = [ [1, 2, 3],
                          [4, 5, 6],
                          [7, 8, 9] ]
    var row = grid[1]

    row[0] = grid[2][2] * 3
    grid[0] = row

