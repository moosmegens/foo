    y: int
    label: string

    // ref is used to modify the arg in place of caller
    fn add(ref self: point_2070, other: point_2070) -> void
    {
        self.x = self.x + other.x
        self.y = self.y + other.y
    }

    fn dot(self: point_2070, other: point_2070) -> int
    {
        return self.x * other.x + self.y * other.y
    }
}

fn compute_2070(a: int, b: int, c: int) -> int
{
    var result = a * b + c - (a + b) * (b - c) * 2
    var sum = 0

    for k in 0..=10
    {
        sum = sum + k * a - b

        if (sum < 100)
        {
            sum = sum + 1
        }
    }

    for k in 0..5
    {
        sum = sum + (k * 2070 + c) * (a - b)
    }

    while (sum > 1000)
    {
        sum = sum - 7
    }

    return result + sum
}

