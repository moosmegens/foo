    return f
}

// ---------------------------------------------------------------- block 3999

struct point_3999
{
    x: int
    y: int
    label: string

    // ref is used to modify the arg in place of caller
    fn add(ref self: point_3999, other: point_3999) -> void
    {
        self.x = self.x + other.x
        self.y = self.y + other.y
    }

    fn dot(self: point_3999, other: point_3999) -> int
    {
        return self.x * other.x + self.y * other.y
    }
}

fn compute_3999(a: int, b: int, c: int) -> int
{
    var result = a * b + c - (a + b) * (b - c) * 2
    var sum = 0

    for k in 0..=10
    {
        sum = sum + k * a - b

        if (sum < 100)
        {
            sum = sum + 1
        }
    }

    for k in 0..5
    {
        sum = sum + (k * 3999 + c) * (a - b)
    }

    while (sum > 1000)
    {
        sum = sum - 7
    }

    return result + sum
}

fn arrays_3999() -> int[][]
{
    var grid: int[][] = [ [1, 2, 3],
                          [4, 5, 6],
                          [7, 8, 9] ]
    var row = grid[1]

    row[0] = grid[2][2] * 3
    grid[0] = row

    var names = ["a", "b", "c"]
    var empty: string[] = []

    return grid
}

fn optional_3999(a: int?) -> int
{
    check a => value
    {
        var doubled: int = value * 2;

        return doubled
    } else
    {
        return -1
    }
}

fn structs_3999() -> int
{
    var p = #point_3999{ x = 1, y = 2, label = "p" }
    var q = #point_3999{ x = 3, y = 4, label = "q" }

    p.add(q)
    p.x = p.x * q.y - p.y

    return p.dot(q) + p.x
}

fn mixed_3999(text: string, flag: bool) -> float
{
    var f = 1.5 * 2.0 + 3.25 - 0.5
    var s = "string number 3999"
    var t = true

    {
        var scoped = 3999 + 1
        scoped = scoped * 2
    }

    return f
}

