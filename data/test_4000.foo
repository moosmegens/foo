// ---------------------------------------------------------------- block 2004

struct point_2004
{
    x: int
    y: int
    label: string

    // ref is used to modify the arg in place of caller
    fn add(ref self: point_2004, other: point_2004) -> void
    {
        self.x = self.x + other.x
        self.y = self.y + other.y
    }

    fn dot(self: point_2004, other: point_2004) -> int
    {
        return self.x * other.x + self.y * other.y
    }
}

fn compute_2004(a: int, b: int, c: int) -> int
{
    var result = a * b + c - (a + b) * (b - c) * 2
    var sum = 0

    for k in 0..=10
    {
        sum = sum + k * a - b

        if (sum < 100)
        {
            sum = sum + 1
        }
    }

    for k in 0..5
    {
        sum = sum + (k * 2004 + c) * (a - b)
    }

    while (sum > 1000)
    {
        sum = sum - 7
    }

    return result + sum
}

fn arrays_2004() -> int[][]
{
    var grid: int[][] = [ [1, 2, 3],
                          [4, 5, 6],
                          [7, 8, 9] ]
    var row = grid[1]

    row[0] = grid[2][2] * 3
    grid[0] = row

    var names = ["a", "b", "c"]
    var empty: string[] = []

    return grid
}

fn optional_2004(a: int?) -> int
{
    check a => value
    {
        var doubled: int = value * 2;

        return doubled
    } else
    {
        return -1
    }
}

fn structs_2004() -> int
{
    var p = #point_2004{ x = 1, y = 2, label = "p" }
    var q = #point_2004{ x = 3, y = 4, label = "q" }

    p.add(q)
    p.x = p.x * q.y - p.y

